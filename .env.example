# ── Contact form ─────────────────────────────────────────────────────────────
#
# Create a free account at https://formspree.io, create a new form, and paste
# the form ID (the part after /f/ in the endpoint URL) here.
#
# Without this value the contact form gracefully falls back to opening the
# visitor's default mail client via a `mailto:` link.
#
VITE_FORMSPREE_ID=your_form_id_here
